# Ignore Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
venv/
env/
ENV/

# IDEs
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Data directories (large files)
data/chromadb/*
data/models/*
data/subtitles/*.srt

# Keep directory structure
!data/.gitkeep
!data/chromadb/.gitkeep
!data/models/.gitkeep
!data/subtitles/.gitkeep

# Node
node_modules/
dist/
build/

# Environment variables
.env
.env.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Docker
*.tar

# Large Data Files
**/data/raw/

# ChromaDB binary data & sqlite (can be hundreds of MB)
**/chroma.sqlite3
**/chroma_db/*.bin
**/chroma_db/*.pickle
**/chromadb/*.bin
**/chromadb/*.pickle

# Subtitle SRT files under service data directories (large corpus)
services/oracle-rag-service/data/subtitles/*.srt

# Temp / debug output files
tmpclaude-*-cwd
nul
*.txt.bak
tmp_*.json
spidey_test.json
test_100*.json
test_comprehensive*.json
debug_query.py
query_analysis.txt
service_log.txt
service_r*.txt
test_100_r*.txt
test_p4_run.py
test_queries.py
test_comprehensive.py
